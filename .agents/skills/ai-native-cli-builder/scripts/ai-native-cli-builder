#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REF_DIR="$SKILL_DIR/references"

usage() {
  cat <<'EOF'
ai-native-cli-builder commands list
ai-native-cli-builder commands search <topic>
ai-native-cli-builder commands help <topic>
ai-native-cli-builder run [--head N] <topic>

Topics:
  method                 Core method for building AI-native CLI tools
  review-rubric          Evaluation rubric for an agent-facing CLI
  implementation-playbook Steps to implement or refactor a CLI toward AI-native shape
EOF
}

file_for() {
  case "$1" in
    method) echo "$REF_DIR/method.md" ;;
    review-rubric) echo "$REF_DIR/review-rubric.md" ;;
    implementation-playbook) echo "$REF_DIR/implementation-playbook.md" ;;
    *) return 1 ;;
  esac
}

list_topics() {
  cat <<'EOF'
method                  Core method for building AI-native CLI tools
review-rubric           Rubric: discoverability, command contracts, recovery, evidence, safety
implementation-playbook  Concrete build/refactor steps for CLI teams
EOF
}

search_topics() {
  local topic="${1:-}"
  if [[ -z "$topic" ]]; then
    echo "missing topic" >&2
    exit 2
  fi
  rg -n -i -- "$topic" "$REF_DIR" || true
}

show_topic() {
  local topic="${1:-}"
  local file
  file="$(file_for "$topic")" || { echo "unknown topic: $topic" >&2; usage >&2; exit 2; }
  sed -n '1,90p' "$file"
}

run_topic() {
  local head_lines=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --head) head_lines="${2:-}"; shift 2 ;;
      --) shift; break ;;
      -*) echo "unknown run flag: $1" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  local topic="${1:-}"
  local file
  file="$(file_for "$topic")" || { echo "unknown topic: $topic" >&2; usage >&2; exit 2; }
  if [[ -n "$head_lines" ]]; then
    sed -n "1,${head_lines}p" "$file"
  else
    cat "$file"
  fi
}

main() {
  case "${1:-}" in
    commands)
      shift
      case "${1:-}" in
        list) list_topics ;;
        search) shift; search_topics "${1:-}" ;;
        help) shift; show_topic "${1:-}" ;;
        *) usage; exit 2 ;;
      esac
      ;;
    run)
      shift
      run_topic "$@"
      ;;
    ""|help|--help|-h) usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
